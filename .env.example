# Copy the keys you need into .env (local) and into your hosting provider's
# environment variables (production). .env is gitignored.

# --- Site ---
# Used to build Stripe redirect URLs. Must be the real origin in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Stripe (required for paid listings) ---
# Dashboard > Developers > API keys. Use sk_test_... until you are ready to charge.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=

# Optional. Without these, checkout builds the line item from lib/pricing.ts, which
# is the source of truth for the amounts either way. Set them if you want revenue to
# roll up per Product in the Stripe dashboard. The amount in Stripe must match
# lib/pricing.ts, otherwise the site advertises one price and charges another.
STRIPE_PRICE_PRIORITY_ADD=
STRIPE_PRICE_FEATURED_YEARLY=
STRIPE_PRICE_FEATURED_MONTHLY=
STRIPE_PRICE_CLAIM_VERIFIED=

# --- Supabase (optional, recommended) ---
# Project Settings > API. The service role key bypasses row level security and is
# server-only: never expose it to the browser and never prefix it with NEXT_PUBLIC_.
# Without these the site still sells and still emails you, it just keeps no record
# and cannot flag featured listings automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Where order notifications go.
NOTIFY_EMAIL=valentin.marin83@gmail.com
# Sender address. Until this is a verified domain, the Resend sandbox sender can
# only deliver to your own address, so customer-facing emails are skipped.
EMAIL_FROM=

# --- Manual overrides ---
# Comma separated clinic ids to feature without a subscription (comps, tests,
# make-goods). Merged on top of whatever is in the database.
FEATURED_CLINIC_IDS=

# --- Existing keys ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GROW_SITE_ID=
GEMINI_API_KEY=
TINYFISH_API_KEY=
